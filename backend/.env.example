# Copy to .env. Defaults here run the API in log-only mail mode.
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated. Production must list the real domain only.
CORS_ORIGINS=http://localhost:5173

# Leave SMTP_HOST empty for log-only mode (no mail credentials needed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT=

RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

CV_PATH=app/assets/John-Patrick-Baldorado-CV.pdf
